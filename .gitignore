# ── Python ───────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual environments ─────────────────
venv/
.venv/
.venv-*/
env/
.env/
ENV/

# ── Secrets — NEVER commit these ─────────
# Google OAuth credentials: keep the real file local.
# client_secret.example.json shows the shape and is the only one committed.
client_secret.json
client_secret_*.json
youtube_token.json
youtube_token.pickle
.env
settings.json
settings.json.tmp
.yaas/
*.pickle
*.pkl

# ── Downloaded fonts (fetched from Google Fonts on first run) ──
assets/fonts/

# ── Generated output — large files ───────
output/
output/images/
*.mp4
*.mp3
*.wav
*.jpg
*.jpeg
*.png
# allow docs screenshots
!docs/screenshots/*.png
# Keep the small, verified README video samples.
!docs/samples/*.mp4
!docs/samples/skylab.jpg
# Preserve the complete narrated comparison and its decoded review evidence.
!docs/samples/comparable-armour/video.mp4
!docs/samples/comparable-armour/**/*.jpg
!docs/samples/comparable-armour/**/*.jpeg
!docs/samples/comparable-armour/**/*.png

# ── OS junk ──────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Logs ─────────────────────────────────
*.log

# Local motion renderer dependencies and generated fixtures
node_modules/
renderers/hyperframes/.smoke/
.pytest_cache/
